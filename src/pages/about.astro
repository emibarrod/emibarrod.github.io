---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import portrait from '../assets/emilio_barragan.jpg';

const title = 'About';
const description =
	'Emilio Barragán — data engineer building production data pipelines with Python, Airflow and dbt.';
---

<Base title={title} description={description} person>
	<div class="shell">
		<header class="page-head">
			<h1 class="display">About</h1>
		</header>

		<div class="layout">
			<div class="prose">
				<p class="lead">
					I'm Emilio, a data engineer. I build the pipelines that move data
					from wherever it lives to wherever someone can actually use it.
				</p>
				<p>
					Most of my work sits in the unglamorous middle of the stack:
					orchestration in Airflow, transformations in dbt, glue code in
					Python, and the quality checks that stop a broken upstream API from
					quietly poisoning a dashboard three weeks later. I care more about
					pipelines that fail loudly and recover cleanly than about pipelines
					that look clever.
				</p>
				<p>
					I studied Computer Science at the Universidad de Sevilla and I'm
					finishing a Master's in Big Data and Data Science at VIU. I started
					out closer to data science — image matching at PwC, ML features at
					Athento — and moved toward engineering when I realised I preferred
					building the systems that make the analysis possible.
				</p>
				<p>
					Right now I'm a Mid Data Engineer at Adsmurai, working on ELT
					pipelines that consolidate marketing, SEO and social listening data,
					and on automating the parts of the job nobody enjoys doing twice.
				</p>
				<p>
					This site is where I write things down — mostly about data
					engineering, Python and the parts of the job that are harder than
					they look. You can find the details of my experience on my <a
						href="/cv">CV</a
					>, or the things I've built for fun under <a href="/work">work</a>.
				</p>

				<div class="find-me">
					<p class="label">Find me</p>
					<SocialLinks variant="labelled" />
				</div>
			</div>

			<figure class="portrait">
				<Image
					src={portrait}
					alt="Emilio Barragán"
					widths={[240, 480, 720]}
					sizes="(min-width: 60rem) 260px, 40vw"
					loading="eager"
				/>
			</figure>
		</div>
	</div>
</Base>

<style>
	.page-head {
		padding-block-end: var(--space-lg);
	}

	.layout {
		display: grid;
		gap: var(--space-xl);
		align-items: start;
	}

	.portrait {
		max-width: 260px;
	}

	.portrait :global(img) {
		border-radius: var(--radius);
		border: 1px solid var(--rule);
	}

	.find-me {
		margin-block-start: var(--space-xl);
		padding-block-start: var(--space-md);
		border-block-start: 1px solid var(--rule);
	}

	.find-me :global(.socials) {
		margin-block-start: var(--space-2xs);
	}

	@media (min-width: 52rem) {
		.layout {
			grid-template-columns: minmax(0, var(--measure)) auto;
		}
		/* Photo leads on mobile, sits beside the prose on desktop. */
		.portrait {
			order: 1;
		}
	}
</style>

---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PostRow from '../components/PostRow.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { INTRO, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { PROJECTS } from '../data/projects';
import { getPublishedPosts } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 4);
const featured = PROJECTS.slice(0, 3);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} person>
	<div class="shell">
		<div class="intro">
			<h1 class="display">{SITE_TITLE}</h1>
			<p class="now">{INTRO}</p>
			<SocialLinks variant="labelled" />
		</div>

		<Section label="Selected work" moreHref="/work" moreLabel="All work">
			<ul class="rows">
				{
					featured.map((project) => (
						<li>
							<div class="row">
								<span class="row-title">{project.name}</span>
								<span class="row-meta mono">{project.year}</span>
								<span class="row-note">{project.summary}</span>
							</div>
						</li>
					))
				}
			</ul>
		</Section>

		<Section
			label="Writing"
			moreHref={posts.length > 0 ? '/blog' : undefined}
			moreLabel="All posts"
		>
			{
				posts.length > 0 ? (
					<ul class="rows">
						{posts.map((post) => (
							<li>
								<PostRow post={post} />
							</li>
						))}
					</ul>
				) : (
					<p class="empty">
						First post in progress. <a href="/rss.xml">Subscribe by RSS</a> if
						you want it when it lands.
					</p>
				)
			}
		</Section>
	</div>
</Base>

<style>
	.intro {
		padding-block-end: var(--space-md);
	}

	.now {
		max-width: var(--measure);
		margin-block: var(--space-md);
		color: var(--fg-muted);
		font-size: var(--text-lg);
		text-wrap: pretty;
	}

	.intro :global(.socials) {
		margin-block-start: var(--space-md);
	}

	@media (min-width: 48rem) {
		.intro {
			padding-block: var(--space-md) var(--space-lg);
		}
	}
</style>

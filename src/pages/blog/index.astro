---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();

const title = 'Writing';
const description =
	'Posts by Emilio Barragán on data engineering, analytics engineering, Python and automation.';
---

<Base title={title} description={description}>
	<div class="shell">
		<header class="page-head">
			<h1 class="display">Writing</h1>
			<p class="lead measure">
				Notes on data engineering, Python, and the parts of the job that are
				harder than they look.
			</p>
		</header>

		{
			posts.length > 0 ? (
				<ul class="rows posts">
					{posts.map((post) => (
						<li>
							<PostRow post={post} />
						</li>
					))}
				</ul>
			) : (
				<div class="empty">
					<p class="label">Nothing published yet</p>
					<p class="empty-body">
						The first post is in progress. It'll be about data engineering —
						pipelines, orchestration, and the failure modes nobody warns you
						about.
					</p>
					<p class="mono">
						<a href="/rss.xml">Subscribe by RSS</a> to get it when it lands.
					</p>
				</div>
			)
		}
	</div>
</Base>

<style>
	.page-head {
		padding-block-end: var(--space-lg);
	}

	.page-head .lead {
		margin-block-start: var(--space-sm);
	}

	.posts {
		border-block-start: 1px solid var(--rule);
	}

	.empty {
		max-width: var(--measure);
		text-align: start;
	}

	.empty-body {
		margin-block: var(--space-2xs) var(--space-md);
		text-wrap: pretty;
	}
</style>

---
import { NAV, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="shell" aria-label="Main">
		<a href="/" class="wordmark">{SITE_TITLE}</a>
		<ul class="links">
			{
				NAV.map((item) => (
					<li>
						<HeaderLink href={item.href}>{item.label}</HeaderLink>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	header {
		border-block-end: 1px solid var(--rule);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		padding-block: var(--space-sm);
	}

	.wordmark {
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
		white-space: nowrap;
	}

	.wordmark:hover {
		color: var(--accent);
	}

	.links {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		list-style: none;
		padding: 0;
	}

	@media (max-width: 30rem) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-2xs);
		}
		.links {
			gap: var(--space-sm);
		}
	}
</style>

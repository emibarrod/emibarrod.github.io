---
import { SITE_AUTHOR } from '../consts';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer>
	<div class="shell inner">
		<p class="mono">© {year} {SITE_AUTHOR}</p>
		<div class="right">
			<a class="mono feed" href="/rss.xml">RSS</a>
			<SocialLinks />
		</div>
	</div>
</footer>

<style>
	footer {
		border-block-start: 1px solid var(--rule);
		padding-block: var(--space-md);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		flex-wrap: wrap;
	}

	.right {
		display: flex;
		align-items: center;
		gap: var(--space-md);
	}

	.feed {
		text-decoration: none;
	}

	.feed:hover {
		color: var(--accent);
	}
</style>
